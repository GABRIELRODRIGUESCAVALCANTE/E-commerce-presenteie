# Configurações do Banco de Dados (PostgreSQL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=presenteie
DB_PASSWORD=suasenha
DB_PORT=5432

# Configurações de Observabilidade e Auditoria
LOG_LEVEL=info
AUDIT_RETENTION_DAYS=90

# URLs da Aplicação (usado para CORS e Auth)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
PORT=3001
ADMIN_EMAIL=teste@gmail.com

# Chave secreta para criptografia de sessões (Better Auth)
BETTER_AUTH_SECRET=uma_chave_longa_e_aleatoria

# Configurações de Upload de Imagem (Cloudinary)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# Configurações de Login Social (Google OAuth - Better Auth)
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# Configurações de E-mail (Nodemailer / Gmail)
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app_do_gmail
