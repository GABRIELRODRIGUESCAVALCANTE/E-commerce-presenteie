# Configuração do Banco de Dados PostgreSQL no Docker
DB_USER=postgres
DB_PASSWORD=postgres_seguro_123
DB_NAME=presenteie
DB_PORT=5432

# URLs da Aplicação
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Chave secreta de autenticação (Better Auth)
BETTER_AUTH_SECRET=chave_muito_segura_e_aleatoria_com_mais_de_32_caracteres

# Admin
ADMIN_EMAIL=admin@presenteie.com

# Cloudinary (Upload de fotos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (SMTP Gmail / Nodemailer)
EMAIL_USER=
EMAIL_PASS=

# Observabilidade
LOG_LEVEL=info
AUDIT_RETENTION_DAYS=90
