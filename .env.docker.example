# Configuração do Banco de Dados PostgreSQL no Docker
DB_USER=postgres
# Gere uma senha forte com: openssl rand -hex 16
DB_PASSWORD=troque_esta_senha
DB_NAME=presenteie
DB_PORT=5432

# URLs da Aplicação
# Local: FRONTEND_URL=http://localhost:5173 | BACKEND_URL=http://localhost:3001 | VITE_API_URL=http://localhost:3001/api
# Produção (mesmo domínio, nginx na frente): use o seu domínio nas três variáveis
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001/api

# Chave secreta de autenticação (Better Auth) — OBRIGATÓRIA. Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Admin
ADMIN_EMAIL=admin@presenteie.com

# Cloudinary (Upload de fotos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (SMTP Gmail / Nodemailer)
EMAIL_USER=
EMAIL_PASS=

# Observabilidade
LOG_LEVEL=info
AUDIT_RETENTION_DAYS=90
